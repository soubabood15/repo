{
  "manifest_version": 3,
  "name": "NEWTEL Quality UCM",
  "version": "1.0.1",
  "description": "Open a linked Quality call in your UCM CDR and fill its search filters.",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "NEWTEL Quality UCM"},
  "content_scripts": [{"matches": ["https://soubabood15.github.io/repo/quality_calls.html*"], "js": ["bridge.js"], "run_at": "document_start"}]
}
