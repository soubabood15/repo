# Copy to C:\ProgramData\Newtel\UcmConnector\ucm.env and fill locally.
# Never commit the real file.
UCM_WS_URL=wss://UCM-INTERNAL-HOST:8089/websockify
UCM_API_USERNAME=
UCM_API_PASSWORD=
CLOUDFLARE_QUEUE_ENDPOINT=https://YOUR-WORKER.workers.dev/integrations/ucm/queue-events
UCM_INGEST_USERNAME=
UCM_INGEST_PASSWORD=
# Optional private CA bundle:
# NODE_EXTRA_CA_CERTS=C:\ProgramData\Newtel\UcmConnector\ucm-ca.pem
# Alternative: exact leaf-certificate SHA-256 pin, independently verified by the
# UCM administrator. Never learn/accept a pin automatically from the network.
# UCM_TLS_FINGERPRINT_SHA256=
# Pin mode still verifies certificate expiry and the hostname in UCM_WS_URL.
