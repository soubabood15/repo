<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.newtel.ucm-queue</string>
  <key>ProgramArguments</key><array><string>/usr/bin/env</string><string>bash</string><string>/usr/local/newtel/run-ucm-queue.sh</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/newtel-ucm-queue.log</string>
  <key>StandardErrorPath</key><string>/var/log/newtel-ucm-queue-error.log</string>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
